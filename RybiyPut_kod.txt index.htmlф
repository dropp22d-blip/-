<title>Рыбий Путь</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Nunito:wght@600;800&display=swap">
<style>
/* Layout: full-screen 3D canvas; HUD strip on top, floating joystick under the thumb, one ability button bottom-right, swap-fish button top-right. Single deliberate underwater look. */
:root{
  --deep:#06303f;
  --ink:#eafcff;
  --sun:#ffc94a;
  --sun-dk:#b9831a;
  --coral:#ff6b5a;
  --glass:rgba(5,40,58,.72);
  --edge:rgba(255,255,255,.22);
  --f-display:'Lilita One','Trebuchet MS',system-ui,sans-serif;
  --f-body:'Nunito',system-ui,sans-serif;
  color-scheme:dark;
}
[hidden]{display:none!important}
html{height:100%;background:var(--deep)}
body{margin:0;height:100%;background:var(--deep);color:var(--ink);font-family:var(--f-body);font-weight:600;overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
#gl{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none}
.gutter{padding-top:max(10px,env(safe-area-inset-top,0px));padding-bottom:max(14px,env(safe-area-inset-bottom,0px));padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));box-sizing:border-box}
#hud{position:fixed;left:0;right:0;top:0;display:flex;flex-wrap:wrap;gap:8px;align-items:center;pointer-events:none}
.pill{background:var(--glass);border:1.5px solid var(--edge);border-radius:999px;padding:5px 13px;display:flex;align-items:center;gap:8px;min-width:0;white-space:nowrap}
#lvName{font-family:var(--f-display);font-size:16px;letter-spacing:.02em}
#dist{font-family:var(--f-display);font-size:16px;color:var(--sun)}
#hearts{font-size:18px;letter-spacing:3px;color:var(--coral);line-height:1}
#wet{position:fixed;left:50%;bottom:max(18px,calc(env(safe-area-inset-bottom,0px) + 8px));transform:translateX(-50%);width:min(52vw,280px);pointer-events:none;opacity:0;transition:opacity .25s}
#wet.on{opacity:1}
#wet small{display:block;text-align:center;font-family:var(--f-display);font-size:13px;margin-bottom:4px;letter-spacing:.04em;text-shadow:0 1px 3px rgba(0,0,0,.6)}
#wet div{height:12px;border-radius:99px;background:rgba(0,0,0,.4);border:1.5px solid var(--edge);overflow:hidden}
#wet i{display:block;height:100%;width:100%;background:linear-gradient(90deg,#41c8ff,#7df0ff);border-radius:99px}
#wet.low i{background:linear-gradient(90deg,#ff5a4a,#ffb04a)}
.round{position:fixed;border-radius:50%;border:3px solid rgba(255,255,255,.88);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;cursor:pointer;padding:0;font-family:var(--f-display);line-height:1;touch-action:none;box-shadow:0 6px 18px rgba(0,0,0,.35);color:#3a1a00}
.round:active{transform:scale(.95)}
.round svg{width:30px;height:30px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
#abil{right:max(16px,env(safe-area-inset-right,0px));bottom:max(22px,calc(env(safe-area-inset-bottom,0px) + 12px));width:96px;height:96px;font-size:14px;
  background:conic-gradient(rgba(3,20,32,.6) var(--cd,0deg),transparent 0),radial-gradient(circle at 35% 30%,#ffe795,#ff9d3d)}
#colors{position:fixed;right:max(16px,env(safe-area-inset-right,0px));bottom:max(126px,calc(env(safe-area-inset-bottom,0px) + 116px));display:grid;grid-template-columns:repeat(3,38px);gap:8px;z-index:6}
#colors .sw{width:38px;height:38px;border-radius:50%;border:3px solid rgba(255,255,255,.85);padding:0;cursor:pointer;touch-action:none;box-shadow:0 3px 8px rgba(0,0,0,.3)}
#colors .sw.on{border-color:#fff;outline:3px solid #222;transform:scale(1.15)}
#swap{right:max(124px,calc(env(safe-area-inset-right,0px) + 108px));bottom:max(22px,calc(env(safe-area-inset-bottom,0px) + 12px));width:78px;height:78px;font-size:11px;background:radial-gradient(circle at 35% 30%,#b6f2ff,#2fa6d8)}
#joy{position:fixed;width:120px;height:120px;margin:-60px 0 0 -60px;border-radius:50%;border:3px solid rgba(255,255,255,.55);background:rgba(255,255,255,.12);pointer-events:none;opacity:0;transition:opacity .15s}
#joy.on{opacity:1}
#joy i{position:absolute;left:50%;top:50%;width:54px;height:54px;margin:-27px 0 0 -27px;border-radius:50%;background:rgba(255,255,255,.7);box-shadow:0 3px 10px rgba(0,0,0,.3)}
#toast{position:fixed;left:50%;top:calc(max(10px,env(safe-area-inset-top,0px)) + 52px);transform:translateX(-50%) translateY(-8px);background:var(--glass);border:1.5px solid var(--edge);border-radius:14px;padding:8px 16px;font-family:var(--f-display);font-size:17px;text-align:center;opacity:0;transition:opacity .25s,transform .25s;width:max-content;max-width:min(86vw,460px);pointer-events:none}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.screen{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;touch-action:pan-y;gap:14px;text-align:center;overflow:auto;
  background:radial-gradient(ellipse at 50% 35%,rgba(8,70,96,.4),rgba(2,16,28,.82));backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px)}
.screen h1{font-family:var(--f-display);font-weight:400;font-size:clamp(46px,13vw,90px);line-height:.95;margin:0;color:var(--sun);text-shadow:0 4px 0 var(--coral),0 10px 24px rgba(0,0,0,.4);text-wrap:balance}
.screen h2{font-family:var(--f-display);font-weight:400;font-size:clamp(28px,7vw,44px);margin:0;color:var(--sun);text-wrap:balance}
.screen p{margin:0;max-width:36ch;font-size:16px;line-height:1.45;opacity:.95;text-wrap:pretty}
.btn{font-family:var(--f-display);font-size:21px;background:var(--sun);color:#3a2300;border:0;border-radius:14px;padding:12px 30px;cursor:pointer;box-shadow:0 4px 0 var(--sun-dk);touch-action:manipulation}
.btn:active{transform:translateY(3px);box-shadow:0 1px 0 var(--sun-dk)}
.btn.ghost{background:transparent;color:var(--ink);box-shadow:none;border:2px solid var(--edge);font-size:17px;padding:9px 22px}
.btn:focus-visible,.card:focus-visible,.round:focus-visible{outline:3px solid #fff;outline-offset:3px}
.row{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
#grid,#pickGrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(142px,1fr));gap:10px;width:100%;max-width:680px}
.card{background:var(--glass);border:2px solid var(--edge);border-radius:16px;padding:8px 8px 12px;color:inherit;font:inherit;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:5px;min-width:0;touch-action:manipulation}
.card canvas{width:100%;max-width:150px;height:auto;aspect-ratio:160/110;border-radius:10px}
.card b{font-family:var(--f-display);font-weight:400;font-size:17px}
.card span{font-size:12.5px;line-height:1.3;opacity:.88}
.card.sel{border-color:var(--sun);box-shadow:0 0 0 4px rgba(255,201,74,.25)}
.card.lock{opacity:.45;cursor:not-allowed}
@media (prefers-reduced-motion:reduce){#toast,#wet,#joy{transition:none}}
#cut{position:fixed;inset:0;pointer-events:none;z-index:6}
#cut:before,#cut:after{content:"";position:absolute;left:0;right:0;height:9vh;background:#000}
#cut:before{top:0}#cut:after{bottom:0}
#cutText{position:absolute;left:50%;bottom:calc(9vh + 14px);transform:translateX(-50%);width:max-content;max-width:min(88vw,600px);margin:0;background:rgba(0,0,0,.6);padding:10px 18px;border-radius:14px;font-family:var(--f-display);font-size:clamp(16px,4.2vw,23px);line-height:1.3;text-align:center;text-wrap:balance}
#cutSkip{position:absolute;right:max(14px,env(safe-area-inset-right,0px));top:calc(9vh + 10px);pointer-events:auto;font-size:15px;padding:7px 16px;background:rgba(0,0,0,.45)}
#cutFade{position:absolute;inset:0;background:#000;opacity:0}
.screen>:first-child{margin-top:auto}.screen>:last-child{margin-bottom:auto}
#pickGrid{max-width:760px}
#grid h3{grid-column:1/-1;margin:14px 0 2px;font-family:var(--f-display);font-weight:400;font-size:28px;color:var(--sun);text-align:left;text-shadow:0 2px 0 var(--coral)}
</style>

<canvas id="gl"></canvas>
<div id="hud" class="gutter" hidden>
  <div class="pill"><span id="lvName"></span></div>
  <div class="pill"><span id="dist"></span></div>
  <div class="pill"><span id="hearts"></span></div>
</div>
<div id="wet"><small>Влажность</small><div><i id="wetBar"></i></div></div>
<div id="joy"><i></i></div>
<button id="abil" class="round" hidden aria-label="Умение рыбки"><svg id="abilSvg" viewBox="0 0 24 24"></svg><span id="abilName"></span></button>
<div id="colors" hidden></div>
<button id="swap" class="round" hidden aria-label="Сменить героя"><svg viewBox="0 0 24 24"><path d="M4 8h13l-3-3M20 16H7l3 3"/></svg><span id="swapName"></span></button>
<div id="toast" role="status"></div>

<section id="menu" class="screen gutter">
  <h1>Рыбий<br>Путь</h1>
  <p>Рыбки сидят в круглых аквариумах в здании посреди города. Каждой нужно выкатиться на улицу и за три уровня добраться до океана. Сначала золотая, потом летучая, надувная, пиранья, дельфин, рыба-капля, осьминог и электрический угорь. С высоты на твёрдое аквариум разбивается, на мягкое нет. На суше рыбки сохнут.</p>
  <button id="playBtn" class="btn">Плыть</button>
</section>

<section id="select" class="screen gutter" hidden>
  <h2>Выбери рыбку</h2>
  <div id="grid"></div>
  <p id="selHint"></p>
  <button id="goBtn" class="btn">Плыть</button>
</section>

<div id="cut" hidden><div id="cutFade"></div><p id="cutText"></p><button id="cutSkip" class="btn ghost">Пропустить ▸</button></div>

<section id="pick" class="screen gutter" hidden>
  <h2>Стань другой рыбкой</h2>
  <p>Кольцо каждые 5 метров. Выбери рыбку с нужной способностью.</p>
  <div id="pickGrid"></div>
  <button id="pickKeep" class="btn ghost">Остаться собой</button>
</section>

<section id="end" class="screen gutter" hidden>
  <h2 id="endTitle"></h2>
  <p id="endText"></p>
  <div class="row">
    <button id="endBtn" class="btn"></button>
    <button id="endBtn2" class="btn ghost" hidden></button>
  </div>
</section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
