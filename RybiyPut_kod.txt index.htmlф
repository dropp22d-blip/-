/* longer maps: more pool/gap pairs of the same kind, in front of the final water */
function extend(segs, n) {
  const body = segs.slice(0, -1), fin = segs[segs.length - 1];
  const pools = body.filter(s => s[0] === 'p'), gaps = body.filter(s => s[0] === 'g'), out = body.slice();
  for (let k = 0; k < n; k++) {
    const pl = pools[(k * 2 + 1) % pools.length], gp = gaps[(k * 3 + 1) % gaps.length];
    out.push(['p', pl[1], Object.assign({}, pl[2])]); out.push(['g', gp[1], Object.assign({}, gp[2] || {})]);
  }
  out.push(fin);
  return out;
}

