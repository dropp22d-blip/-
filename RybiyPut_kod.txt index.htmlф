    { dur: 2.4, noPlayer: true, text: 'Хамелеон меняет цвет и прицеливается...', cam: u => camSet(mix3([cx - 24, 3.2, cz + 17], [cx - 18, 5, cz + 12], smooth(u)), [lerp(shore[0], cx, 0.3 * u), 1.5, lerp(shore[2], cz, 0.3 * u)]),
      act: (u, dt, t) => { swim(t); cham.position.set(shore[0], shore[1] + 1.6 - u * 0.3, shore[2]); cham.rotation.y = -0.9; cham.scale.set(0.9 * (1 + u * 0.1), 0.9 * (1 - u * 0.15), 0.9); colorize(0.4 + u * 1.5); } },
    { dur: 2.6, noPlayer: true, text: 'И прыгает к ним в воду!', cam: u => camSet(mix3([cx - 18, 5, cz + 12], [cx - 8, 7, cz + 10], smooth(u)), [lerp(shore[0], tgt[0], smooth(u)), lerp(3, 0, u), lerp(shore[2], tgt[2], smooth(u))]),
      act: (u, dt, t) => { swim(t); const e = Math.min(1, u / 0.85), x = lerp(shore[0], tgt[0], e), z = lerp(shore[2], tgt[2], e), y = lerp(shore[1] + 1.3, tgt[1], e) + Math.sin(e * Math.PI) * 9;
        cham.position.set(x, y, z); cham.rotation.y = Math.atan2(-(tgt[2] - shore[2]), tgt[0] - shore[0]); cham.rotation.z = (e - 0.5) * -0.8; cham.scale.set(0.9, 0.9, 0.9); colorize(1.9 + u);
        if (u >= 0.85 && !splashed) { splashed = true; splash(tgt[0], tgt[2], 40); blip(160, 0.4, 'sine', 0.12); } if (u >= 0.85) cham.visible = false; } },
    { dur: 3.6, noPlayer: true, text: 'Всплеск! Новый друг уже в океане. Кто он такой?..', cam: u => orbitC(2.2 + u * 0.5, 18 - u * 4, 7),
      act: (u, dt, t) => { fs.forEach(o => { const an = o.a + t * 0.5, x = cx + Math.cos(an) * 6, z = cz + Math.sin(an) * 6; o.f.root.position.set(x, -0.55 + Math.max(0, Math.sin(t * 4 + o.i)) * 1.4, z); o.f.root.rotation.y = Math.atan2(cz - z, cx - x) * -1; o.f.wag(Math.sin(time * 9 + o.i) * 0.4); }); $('cutFade').style.opacity = smooth(clamp((u - 0.7) / 0.3, 0, 1)); } }
  ];
  startCut(shots, () => { clearFin(); done(); });
}

/* ---------- main loop ---------- */
function updateHUD() {
  const L = LVL;
  if (LVL.museum) $('dist').textContent = 'До трубы: ' + Math.max(0, Math.round(LVL.goalX - P.x)) + ' м'; else { $('dist').textContent = (LVL.jungle ? (LVL.meme ? (LVL.yt ? 'До Ютуб-лэнда: ' : 'До Мемо-лэнда: ') : 'До джунглей: ') : 'До океана: ') + ''; $('dist').textContent += Math.round(lerp(L.km[0], L.km[1], clamp(P.x / L.goalX, 0, 1))) + ' км'; }
  $('hearts').textContent = '♥'.repeat(Math.max(0, lives)) + '♡'.repeat(Math.max(0, 3 - lives));
  const w = $('wet'), wv = P.slime ? clamp(P.slimeT / 8, 0, 1) : P.wet, show = !SPEC[P.type].liz && (P.slime || !P.inWater || P.wet < 0.99);
  w.classList.toggle('on', show); w.classList.toggle('low', wv < 0.35);
  $('wetBar').style.width = (wv * 100) + '%';
  const sw = $('swap'); sw.hidden = !(LVL.collect && roster.length > 1 && !P.bowl);
  const b = $('abil');
  if (P.bowl !== b.hidden && SPEC[P.type].ab) b.hidden = P.bowl;
  if (!b.hidden) {
    const frac = P.type === 'puffer' ? 0 : clamp(P.cd / (P.cdMax || 1), 0, 1);
    b.style.setProperty('--cd', (frac * 360) + 'deg');
    $('abilName').textContent = (P.type === 'dolphin' && aim) ? (aimDist(aim.t) / 5).toFixed(1).replace('.', ',') + ' м' : (P.storyT > 0) ? Math.ceil(P.storyT) + ' с' : (P.camo) ? (LVL.museum ? 'Снять' : Math.ceil(P.camoT) + ' с') : P.type === 'puffer' ? (P.infl ? 'Сдуться' : 'Раздуться') : ((P.type === 'flyer' || P.type === 'dragon') && P.fly ? 'Спуск' : SPEC[P.type].ab);
  }
}
function update(dt) {
  time += dt;
  if (shake > 0) shake = Math.max(0, shake - dt);
  updateWater(time, camera.position.x + 12, camera.position.z);
  skyGroup.position.copy(camera.position);
  for (const c of clouds) { const u = c.userData; u.x += u.v * dt; if (u.x > 450) u.x = -450; c.position.set(u.x, u.y, u.z); }
  const sp0 = LVL.pools[0];
  sun.position.set(camera.position.x + 40, 60, camera.position.z + 20); sun.target.position.copy(camera.position);
  updateParts(dt);
  if (mode === 'menu') {
    bowl.visible = false;
    const a = time * 0.18;
    camera.position.set(sp0.x + Math.cos(a) * 16, 6.5, sp0.z + Math.sin(a) * 16); camera.lookAt(sp0.x, -0.5, sp0.z);
    const fa = time * 0.7; fishObj.root.position.set(sp0.x + Math.cos(fa) * 4, -0.45, sp0.z + Math.sin(fa) * 3);
    fishObj.root.rotation.y = Math.atan2(-Math.cos(fa) * 3, -Math.sin(fa) * 4);
    fishObj.wag(Math.sin(time * 8) * 0.4); ripple.visible = false; shadow.visible = false;
    return;
  }
  if (mode === 'play') {
    updatePlayer(dt);
    if (mode !== 'play') return;
    updateHerons(dt); updateEnv(dt, time); aimUpdate(dt); updateProgress();
    if ((LVL.jungle || LVL.museum) ? (P.x > LVL.goalX && !P.air) : (P.inWater && P.x > LVL.goalX)) levelDone();
    updateCamera(dt); updateHUD();
  } else if (mode === 'cut') {
    updateEnv(0, time); updateCut(dt);
  } else if (mode === 'anim') {
    animT += dt;
    if (wonFinal) {
      P.x += (SPEC[P.type].liz ? 4 : 5) * dt; P.rot += angDiff(P.rot, 0) * 0.1; if (!LVL.noWater) P.y = Math.max(P.y - 0.3 * dt, -1.2);
      fishObj.root.position.set(P.x, P.y, P.z); fishObj.root.rotation.y = P.rot; fishObj.wag(Math.sin(time * 9) * 0.4);
      camera.position.x += (P.x - 14 - camera.position.x) * 0.02; camera.position.y += (10 - camera.position.y) * 0.02; camera.lookAt(P.x + 8, 0, P.z);
      if (Math.random() < dt * 8) emit(P.x + rnd(-3, 3), 0.1, P.z + rnd(-3, 3), rnd(-2, 2), rnd(5, 9), rnd(-2, 2), 1, 0xffffff, 0.15, 14);
      if (animT > 3.6) afterLevel();
    } else {
      P.x += 3 * dt; fishObj.root.position.x = P.x; fishObj.wag(Math.sin(time * 9) * 0.4);
      updateCamera(dt);
      if (animT > 1.3) afterLevel();
    }
  }
}
let last = performance.now();
function loop(now) {
  const dt = Math.min(0.05, (now - last) / 1000); last = now;
  update(dt);
  if (renderer) renderer.render(scene, camera);
  requestAnimationFrame(loop);
}

/* ---------- input ---------- */
const joyEl = $('joy'), knob = joyEl.firstElementChild;
let joyId = -1; const jb = { x: 0, y: 0 };
window.addEventListener('pointerdown', e => {
  if (AC && AC.state === 'suspended') AC.resume();
  if (e.target.closest('.round,.screen,button')) return;
  if (mode !== 'play' || joyId !== -1) return;
  joyId = e.pointerId; jb.x = e.clientX; jb.y = e.clientY;
  joyEl.style.left = jb.x + 'px'; joyEl.style.top = jb.y + 'px'; knob.style.transform = 'translate(0,0)'; joyEl.classList.add('on');
});
window.addEventListener('pointermove', e => {
  if (e.pointerId !== joyId) return;
  let dx = e.clientX - jb.x, dy = e.clientY - jb.y; const l = Math.hypot(dx, dy), R = 50;
  if (l > R) { dx = dx / l * R; dy = dy / l * R; }
  knob.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
  const dead = Math.min(l, R) < 6 ? 0 : 1;
  inp.x = -dy / R * dead; inp.z = dx / R * dead;
});
const joyUp = e => { if (e.pointerId === joyId) { joyId = -1; inp.x = inp.z = 0; joyEl.classList.remove('on'); } };
window.addEventListener('pointerup', joyUp); window.addEventListener('pointercancel', joyUp);
window.addEventListener('keydown', e => { if (e.code === 'Space') { e.preventDefault(); if (!e.repeat) { if (P && P.type === 'dolphin') aimStart(); else useAbility(); } } keys[e.code] = true; });
window.addEventListener('keyup', e => { keys[e.code] = false; if (e.code === 'Space') aimRelease(); });
window.addEventListener('contextmenu', e => e.preventDefault());
$('abil').addEventListener('pointerdown', e => { e.preventDefault(); e.stopPropagation(); if (P && P.type === 'dolphin') { aimPid = e.pointerId; aimStart(); } else useAbility(); });
window.addEventListener('pointerup', e => { if (e.pointerId === aimPid) { aimPid = -1; aimRelease(); } });
window.addEventListener('pointercancel', e => { if (e.pointerId === aimPid) { aimPid = -1; aim = null; aimGroup.visible = false; } });
$('playBtn').addEventListener('click', () => showSelect());
$('goBtn').addEventListener('click', () => { if (sel === 'lfinal') { if (allLizFreed()) startLizFinal(); else toast('Сначала верни в джунгли всех ящериц'); return; } if (sel === 'final') { if (allFreed()) startFinalLevel(); else toast('Сначала освободи в океан всех рыбок'); return; } SAVE.prog[sel] = 0; startLevel(sel, 0); });

/* ---------- boot ---------- */
buildLevel('gold', 0);
P = newPlayer('gold'); setFish('gold'); playUI(false);
showScreen('menu');
if (!renderer) { $('menu').querySelector('p').textContent = 'Эта игра использует 3D-графику, но браузер её не запустил. Открой страницу в другом браузере.'; $('playBtn').hidden = true; }
requestAnimationFrame(loop);
</script>
